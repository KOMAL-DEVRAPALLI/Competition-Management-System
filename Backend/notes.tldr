							"content": [
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "field.label         ↓ <label>  field.type         ↓ <input type>  field.name         ↓ name  formData[field.name]         ↓ value  handleChange         ↓ onChange "
								}
							]
						},
						{
							"type": "heading",
							"attrs": {
								"dir": "auto",
								"level": 2
							},
							"content": [
								{
									"type": "text",
									"text": "Why use it?"
								}
