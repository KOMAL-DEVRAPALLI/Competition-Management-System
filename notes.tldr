							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "categories = [     {         label: \"60\",         limit: 60,         isPlus: false,     },     {         label: \"65\",         limit: 65,         isPlus: false,     },     {         label: \"70\",         limit: 70,         isPlus: false,     },     {         label: \"+70\",         limit: null,         isPlus: true,     }, ];"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "Separate them into:"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "publishedCategories = [     {         label: \"60\",         limit: 60,     },     {         label: \"65\",         limit: 65,     },     {         label: \"70\",         limit: 70,     }, ];  plusCategory = {     label: \"+70\",     limit: null, };"
								}
							]
						},
						{
							"type": "heading",
							"attrs": {
								"dir": "auto",
								"level": 1
							},
							"content": [
								{
									"type": "text",
									"text": "Example 1"
